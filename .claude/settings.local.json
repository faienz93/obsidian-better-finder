{
  "env": {
    "CLAUDE_CODE_HIDE_ACCOUNT_INFO": "1"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:docs.obsidian.md)",
      "WebFetch(domain:forum.obsidian.md)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:marcus.se.net)",
      "WebFetch(domain:marcusolsson.dev)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [
      "Bash(**/*.env)",
      "Read(**/*.env)",
      "Write(**/*.env)"
    ]
  },
  "model": "opus",
  "alwaysThinkingEnabled": false
}
