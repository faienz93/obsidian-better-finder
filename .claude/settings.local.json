{
  "env": {
    "CLAUDE_CODE_HIDE_ACCOUNT_INFO": "1"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:docs.obsidian.md)",
      "WebFetch(domain:forum.obsidian.md)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:marcus.se.net)",
      "WebFetch(domain:marcusolsson.dev)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Read(//opt/**)",
      "Bash(flatpak list *)",
      "Bash(snap list *)",
      "WebFetch(domain:publish.obsidian.md)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:webdriver.io)",
      "WebFetch",
      "WebSearch",
      "WebFetch(domain:jesse-r-s-hines.github.io)",
      "Bash(git branch *)",
      "Bash(npm run *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(python3 -c \"import json; json.load\\(open\\('package.json'\\)\\); print\\('JSON valido'\\)\")",
      "Bash(npx jest *)",
      "Bash(sed -i -e 's|void this.saveSettings\\(\\);|this.saveSettings\\(\\).catch\\(console.error\\);|' -e 's|void xbergExtractor.indexAll\\(\\);|xbergExtractor.indexAll\\(\\).catch\\(console.error\\);|' -e 's|void xbergExtractor.indexFile\\(file\\);|xbergExtractor.indexFile\\(file\\).catch\\(console.error\\);|g' main.ts)",
      "Bash(sed -i 's|void this.core.exportResults\\(this.allResults, this.searchBar.getValue\\(\\)\\);|this.core.exportResults\\(this.allResults, this.searchBar.getValue\\(\\)\\).catch\\(console.error\\);|' src/FinderCard.ts)",
      "Bash(sed -i 's|void this.updateFile\\(file\\);|this.updateFile\\(file\\).catch\\(console.error\\);|' src/engine/CanvasTagCache.ts)",
      "Bash(npm test *)",
      "Bash(node -e ' *)",
      "Bash(node *)",
      "Bash(npx eslint *)",
      "Bash(echo \"EXIT: $?\")"
    ],
    "deny": [
      "Bash(**/*.env)",
      "Read(**/*.env)",
      "Write(**/*.env)"
    ]
  },
  "model": "opus",
  "alwaysThinkingEnabled": false,
  "plansDirectory": ".claude/plans"
}
