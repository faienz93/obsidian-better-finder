{
  "env": {
    "CLAUDE_CODE_HIDE_ACCOUNT_INFO": "1"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:docs.obsidian.md)",
      "WebFetch(domain:forum.obsidian.md)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:marcus.se.net)",
      "WebFetch(domain:marcusolsson.dev)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Read(//opt/**)",
      "Bash(flatpak list *)",
      "Bash(snap list *)",
      "WebFetch(domain:publish.obsidian.md)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:webdriver.io)",
      "WebFetch",
      "WebSearch",
      "WebFetch(domain:jesse-r-s-hines.github.io)",
      "Bash(git branch *)",
      "Bash(npm run *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(**/*.env)",
      "Read(**/*.env)",
      "Write(**/*.env)"
    ]
  },
  "model": "opus",
  "alwaysThinkingEnabled": false,
  "plansDirectory": ".claude/plans"
}
